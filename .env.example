# Provider Selection ("minimax" or "aliyun")
PROVIDER=minimax

# MiniMax provider via ByteDance ARK coding plan (Anthropic-compatible)
ARK_API_KEY=your_api_key_here
# ARKCODE_API_KEY=your_api_key_here
ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
ARK_MODEL=minimax-m3

# Aliyun API Configuration
ALIYUN_API_KEY=your_api_key_here
ALIYUN_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
ALIYUN_MODEL=qwen3.6-plus

# ByteDance API Configuration
BYTEDANCE_API_KEY=your_api_key_here
BYTEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
BYTEDANCE_MODEL=glm-5.1

# Model Configuration (main loop/team loop use streaming calls)
MAX_TOKENS=30000

# Context Management
TOKEN_THRESHOLD=150000
KEEP_RECENT=3

# Iteration Limits
MAX_ROUNDS=10
MAX_ITERATIONS=10
